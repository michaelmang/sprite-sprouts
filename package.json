{
  "name": "sprite-sprouts",
  "version": "0.1.0",
  "private": true,
  "description": "Catalog of AI-generated sprite outlines and finalized pixel art for a Stardew Valley-like game.",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sprites:validate": "tsx scripts/validate-sprites.ts",
    "sprites:audit": "tsx scripts/audit-sprites.ts",
    "sprites:new": "tsx scripts/new-sprite.ts",
    "sprites:render": "tsx scripts/render-sprites.ts",
    "sprites:catalog": "tsx scripts/generate-catalog.ts"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
