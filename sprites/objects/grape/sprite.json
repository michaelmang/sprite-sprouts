      "pixels": [
        "................",
        "................",
        "........aa......",
        "........bc......",
        "......aabbaa....",
        ".....defffefd...",
        "....degefegefg..",
        "....gfefffefg...",
        ".....fffefffg...",
        "....defegefefd..",
        "...degefefegefg.",
        "...gfefffffefg..",
        "....gfffefffg...",
        ".....gfegefg....",
        "......gfefg.....",
        ".......ggg......"
      ]
