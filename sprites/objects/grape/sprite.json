      "name": "empty",
      "color": null
    },
    "a": {
      "name": "leaf-light",
      "color": "#7cc45f"
    },
    "b": {
      "name": "leaf-base",
      "color": "#4a9a44"
    },
    "c": {
      "name": "leaf-dark",
      "color": "#2c6630"
    },
    "d": {
      "name": "grape-light",
      "color": "#ac7bcd"
    },
    "e": {
