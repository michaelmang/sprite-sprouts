{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "gold-ore",
  "name": "Gold Ore",
  "kind": "object",
  "status": "outline",
  "description": "Raw gold from late-mine nodes.",
  "tags": ["resource"],
  "canvas": {
    "width": 16,
    "height": 16
