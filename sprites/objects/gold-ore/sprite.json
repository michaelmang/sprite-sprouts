        "...aefgeeegehf..",
        "...begeeehegeg..",
        ".aadgeefgeheehf.",
        ".bbdgeeghgeegeg.",
        ".bbdgehegeefgeg.",
        ".bbdggeheefgeg..",
        ".ccbeggeegggeg..",
        "...cheeggeeeg...",
        "....ggheeggg....",
        "......ggg.......",
        "................"
