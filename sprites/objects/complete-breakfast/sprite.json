    "a": {
      "name": "cheese-outline",
      "color": "#7a5406"
    },
    "b": {
      "name": "cheese-light",
      "color": "#fbdf85"
    },
    "c": {
      "name": "cheese-dark",
      "color": "#bd8a12"
    },
    "d": {
      "name": "cheese-base",
      "color": "#efc23c"
    },
    "e": {
      "name": "white-dark",
      "color": "#bab6ab"
    },
    "f": {
      "name": "white-outline",
      "color": "#7d7a72"
    },
    "g": {
      "name": "white-light",
      "color": "#ffffff"
