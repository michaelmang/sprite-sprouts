  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "................",
        "................",
        ".....a..........",
        "...bacab.baaab..",
        "...abdca.abbca..",
        "..acdddcaaccca..",
        "...acdca.caaac..",
        "...efefe........",
        ".....f..........",
        "....gffffffg....",
        "....feeeeeef....",
        "....effffffe....",
        "................",
        "................"
      ]
    }
