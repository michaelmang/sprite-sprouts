{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "omni-geode",
  "name": "Omni Geode",
  "kind": "object",
  "status": "outline",
  "description": "A geode that can hold any mineral.",
  "tags": ["resource"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "#": {
      "name": "outline",
      "color": "#2b2118"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "................",
        "........#.......",
        "....#########...",
        "....##..#..##...",
        "....#.#.#.#.#...",
        "....#..###..#...",
        "...###########..",
        "....#..###..#...",
        "....#.#.#.#.#...",
        "....##..#..##...",
        "....#########...",
        "........#.......",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
