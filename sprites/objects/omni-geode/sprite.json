        "...aaddbbddaa...",
        "...bdccddacdc...",
        "...dcefeefecd...",
        "...dcfeggefcd...",
        ".aabdeggggedba..",
        ".ccbdeggggedbc..",
        "...dafeggefcd...",
        "...dcefeefecd...",
        "...bdccddccdc...",
        "...ccddbbddcc...",
        ".......cc.......",
        "................",
        "................"
