{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "ruby",
  "name": "Ruby",
  "kind": "object",
  "status": "outline",
  "description": "A deep red cut gem.",
  "tags": ["gem", "mineral"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "ruby-light",
      "color": "#ec6b83"
    },
    "b": {
      "name": "ruby-outline",
      "color": "#4e0d1c"
    },
    "c": {
      "name": "ruby-base",
      "color": "#cc2a4c"
    },
    "d": {
      "name": "ruby-dark",
      "color": "#8f1830"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        ".....aaaaaa.....",
        ".....bbccbb.....",
        "....badbbadb....",
        "....badbbadb....",
        "...bdddbbdddb...",
        ".aabbbbccbbbba..",
        ".cbaaadbbaaadb..",
        ".dbdccdbbaccdb..",
        "...bacdbbacdb...",
        "...bdcdbbacdb...",
        "....badbbadb....",
        "....bddbbddb....",
        ".....bbddbb.....",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
