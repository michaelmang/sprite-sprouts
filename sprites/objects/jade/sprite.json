{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "jade",
  "name": "Jade",
  "kind": "object",
  "status": "outline",
  "description": "A smooth green stone.",
  "tags": ["gem", "mineral"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "emerald-light",
      "color": "#5fd6a5"
    },
    "b": {
      "name": "emerald-outline",
      "color": "#08402c"
    },
    "c": {
      "name": "emerald-dark",
      "color": "#12734b"
    },
    "d": {
      "name": "emerald-base",
      "color": "#1fa870"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        ".......aa.......",
        ".......bb.......",
        "....abbacbba....",
        "...abcaccacba...",
        "...bcbcbbcdcb...",
        "...bacbccbccb...",
        ".abacbcbbcbacb..",
        ".cbccbcbbcbacb..",
        "...bacbccbccb...",
        "...bcdcbbcbcb...",
        "...cbccaaccbc...",
        "....cbbccbbc....",
        ".......bb.......",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
