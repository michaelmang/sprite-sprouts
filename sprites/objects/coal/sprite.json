{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "coal",
  "name": "Coal",
  "kind": "object",
  "status": "outline",
  "description": "Fuel for furnaces.",
  "tags": ["resource"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "coal-light",
      "color": "#5c5c69"
    },
    "b": {
      "name": "coal-base",
      "color": "#3b3b45"
    },
    "c": {
      "name": "coal-dark",
      "color": "#26262c"
    },
    "d": {
      "name": "coal-outline",
      "color": "#111114"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "......aaaaa.....",
        "......bbbbc.....",
        ".....adddbbaa...",
        "....adcccddbc...",
        "...abbddddcdba..",
        "...bddbbbdacdc..",
        ".aadacdbbdacdba.",
        ".bbdccdbbdcbcdc.",
        ".ccbdcdddbdcdc..",
        "...bbddacdbdbc..",
        "...cbdccbcdbc...",
        "....bbddcccdc...",
        "....cccbdddc....",
        ".......cccc.....",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
