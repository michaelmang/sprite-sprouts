{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "bone-fragment",
  "name": "Bone Fragment",
  "kind": "object",
  "status": "outline",
  "description": "A shard of old bone.",
  "tags": ["resource"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "bone-light",
      "color": "#f6f0dc"
    },
    "b": {
      "name": "bone-base",
      "color": "#e0d7bb"
    },
    "c": {
      "name": "bone-dark",
      "color": "#b7ac8b"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        ".............aa.",
        ".............bc.",
        "............abc.",
        "..........aabc..",
        "..........bbbc..",
        ".........abbc...",
        "......aaabbc....",
        "......bbbbc.....",
        "...aaabbbc......",
        "...bbbbcc.......",
        "...bbbc.........",
        ".aabcc..........",
        ".bbc............",
        ".cc.............",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
