{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "diamond",
  "name": "Diamond",
  "kind": "object",
  "status": "outline",
  "description": "A rare brilliant gem.",
  "tags": ["gem", "mineral"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "glass-light",
      "color": "#dcecf1"
    },
    "b": {
      "name": "glass-outline",
      "color": "#3b5560"
    },
    "c": {
      "name": "glass-base",
      "color": "#a7c6cf"
    },
    "d": {
      "name": "glass-dark",
      "color": "#6e909c"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "........aa......",
        ".......abca.....",
        "......abdbca....",
        ".....abacdbca...",
        "....abdddddbca..",
        "...accbbbbbcccd.",
        "...dccbbbbbbcd..",
        "....cbdaaaadbd..",
        "....dcbdccdbd...",
        ".....dcbddbd....",
        "......dcbbd.....",
        ".......cccd.....",
        ".......dcd......",
        "........d......."
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
