{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "rock",
  "name": "Rock",
  "kind": "object",
  "status": "outline",
  "description": "A small breakable stone.",
  "tags": ["world", "mine"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "stone-light",
      "color": "#b9b6ae"
    },
    "b": {
      "name": "stone-outline",
      "color": "#33322f"
    },
    "c": {
      "name": "stone-dark",
      "color": "#5d5b57"
    },
    "d": {
      "name": "stone-base",
      "color": "#8b8880"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "................",
        ".........abb....",
        "......abbbacb...",
        "......bacbacb...",
        ".....badcbadcb..",
        ".....bacbaddcb..",
        "....badcbadddcb.",
        "....bcdcbcdddcb.",
        "....bbadcbaddcb.",
        "...baaddcbcdcb..",
        "...bccccccbccb..",
        "...cbbbbbbcbbc..",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
