        "...ababbbbbba...",
        "...bcbcaaaacb...",
        "..ddbcbcccccb...",
        "...cdbcbbbbbc...",
        "....c...........",
        "..abbbbbbbaa....",
        "..baaaaaacbdb...",
        "..bccccccbcbcb..",
        "..cbbbbbbcbdb...",
        "...........c....",
        "................",
        "................"
      ]
    }
