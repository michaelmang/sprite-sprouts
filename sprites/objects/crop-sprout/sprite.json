{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "crop-sprout",
  "name": "Crop Sprout",
  "kind": "object",
  "status": "outline",
  "description": "Generic first-growth crop tile.",
  "tags": ["crop"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "leaf-light",
      "color": "#7cc45f"
    },
    "b": {
      "name": "leaf-base",
      "color": "#4a9a44"
    },
    "c": {
      "name": "leaf-outline",
      "color": "#17351a"
    },
    "d": {
      "name": "leaf-dark",
      "color": "#2c6630"
    },
    "e": {
      "name": "soil-base",
      "color": "#6f5030"
    },
    "f": {
      "name": "soil-light",
      "color": "#8f6c46"
    },
    "g": {
      "name": "soil-dark",
      "color": "#4e3620"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "................",
        "................",
        "................",
        "....a.......a...",
        "....bc..a..cd...",
        "...bcdccbccdcd..",
        ".....ccdcdcc....",
        ".......cbc......",
        "........d.......",
        "........d.......",
        "........d.......",
        "..eeffffeffffeg.",
        "....ggggggggg...",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
