{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "cheese",
  "name": "Cheese",
  "kind": "object",
  "status": "outline",
  "description": "A wheel of cow cheese.",
  "tags": ["food", "crafted", "artisan"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "cheese-light",
      "color": "#fbdf85"
    },
    "b": {
      "name": "cheese-base",
      "color": "#efc23c"
    },
    "c": {
      "name": "cheese-dark",
      "color": "#bd8a12"
    },
    "d": {
      "name": "cheese-outline",
      "color": "#7a5406"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        ".......aa.......",
        ".......bc.......",
        "......dbbd......",
        "....ddcddcdd....",
        "...daacddaccd...",
        "...dabcddcdccd..",
        "...dabcdbdcdcd..",
        "...dabcdbdcdcd..",
        ".adabbcddcdacd..",
        ".bdabbcddaacd...",
        ".bdccccddcccd...",
        ".ccddddccdddc...",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
