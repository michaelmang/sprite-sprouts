      "color": "#4a9a44"
    },
    "c": {
      "name": "pumpkin-light",
      "color": "#f4a852"
    },
    "d": {
      "name": "pumpkin-outline",
      "color": "#5e2b06"
    },
    "e": {
      "name": "pumpkin-base",
      "color": "#dd7c1c"
