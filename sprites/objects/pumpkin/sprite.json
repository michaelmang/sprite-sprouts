  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "................",
        "........a.......",
        "........ba......",
        ".....cddeddc....",
        "....cdcfdcfdc...",
        "....edcfdcfdf...",
        "....ddcfdcfdd...",
        "...dfdcfdcfdfd..",
        "....ddcfdcfdd...",
        "....edcfdcfdf...",
        "....fdffdffdf...",
        ".....fddeddf....",
        "........f.......",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
