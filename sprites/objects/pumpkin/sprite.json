{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "pumpkin",
  "name": "Pumpkin",
  "kind": "object",
  "status": "outline",
  "description": "A ribbed autumn squash.",
  "tags": ["crop", "produce"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
