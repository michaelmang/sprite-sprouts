{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "cauliflower",
  "name": "Cauliflower",
  "kind": "object",
  "status": "outline",
  "description": "A dense white curd on a stem.",
  "tags": ["crop", "produce"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
