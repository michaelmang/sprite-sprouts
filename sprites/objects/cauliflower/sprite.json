    "#": {
      "name": "outline",
      "color": "#2b2118"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        "........#.......",
        "......##.##.....",
        ".....#.....#....",
        ".....#.....#....",
        "....#.#...#.#...",
        "...#.#.#.#.#.#..",
        "....###...###...",
        ".....###.###....",
        "........#.......",
        "........#.......",
        "........#.......",
        "........#.......",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
