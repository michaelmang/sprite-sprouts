{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "seed-maker",
  "name": "Seed Maker",
  "kind": "object",
  "status": "outline",
  "description": "Turns crops back into seeds.",
  "tags": ["machine", "crafting"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "iron-base",
      "color": "#8b95a4"
    },
    "b": {
      "name": "iron-dark",
      "color": "#525b68"
    },
    "c": {
      "name": "wood-light",
      "color": "#c89355"
    },
    "d": {
      "name": "wood-outline",
      "color": "#3a2412"
    },
    "e": {
      "name": "wood-dark",
      "color": "#6b4520"
    },
    "f": {
      "name": "wood-base",
      "color": "#a06a34"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        ".....aaaaab.....",
        "................",
        "...cddddddddc...",
        "...dccccccced...",
        "...dcfeeeefed...",
        "...dceddddced...",
        "...dcedcedced...",
        "...dcedeedced...",
        "...dceddddced...",
        "...dcfccccfed...",
        "...deeeeeeeed...",
        "...edddddddde...",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
