        "................",
        "................",
        ".......aa.......",
        ".......bb.......",
        ".....abacba.....",
        ".....bccccb.....",
        "...abcbbbbcba...",
        "...bcbcbbcbcb...",
        "...bcbcbbcbcb...",
        ".dbccbbccbbacb..",
        "...bcacbbcbcb...",
        "...cbcbddbcbc...",
        "....cbccccbc....",
        "................",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
