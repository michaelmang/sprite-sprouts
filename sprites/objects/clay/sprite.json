{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "clay",
  "name": "Clay",
  "kind": "object",
  "status": "outline",
  "description": "Soft earth for pottery and flooring.",
  "tags": ["resource"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
