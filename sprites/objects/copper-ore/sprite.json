{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "copper-ore",
  "name": "Copper Ore",
  "kind": "object",
  "status": "outline",
  "description": "Raw copper from rocky nodes.",
  "tags": ["resource"],
  "canvas": {
    "width": 16,
    "height": 16
