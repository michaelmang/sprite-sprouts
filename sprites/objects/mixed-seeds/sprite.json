  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "................",
        ".....ab..ab.....",
        ".....b...b......",
        "...aa..ab...aa..",
        "...cb..b....cb..",
        "...cb.......cb..",
        "...ddeeeeeeedf..",
        "...ddgdddgggdf..",
        "...dgfgggeffgde.",
        "...dgfgfffggfgf.",
        "...dgefggfgefgf.",
        "...dgffgfggfgdf.",
        "...ddggffgdgff..",
        "...fffdggdff....",
        "......ffff......"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
