{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "mixed-seeds",
  "name": "Mixed Seeds",
  "kind": "object",
  "status": "outline",
  "description": "Wild seeds that grow a random crop.",
  "tags": ["seed"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "linen-light",
      "color": "#f2ead1"
    },
    "b": {
      "name": "linen-dark",
      "color": "#a89b81"
    },
    "c": {
      "name": "linen-base",
      "color": "#d8ccae"
    },
    "d": {
      "name": "leaf-base",
      "color": "#4a9a44"
    },
    "e": {
      "name": "leaf-light",
      "color": "#7cc45f"
    },
    "f": {
      "name": "leaf-dark",
      "color": "#2c6630"
    },
    "g": {
      "name": "leaf-outline",
      "color": "#17351a"
    }
