{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "fence",
  "name": "Fence",
  "kind": "object",
  "status": "outline",
  "description": "Keeps animals in a pasture.",
  "tags": ["farm"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "wood-light",
      "color": "#c89355"
    },
    "b": {
      "name": "wood-base",
      "color": "#a06a34"
    },
    "c": {
      "name": "wood-dark",
      "color": "#6b4520"
    },
    "d": {
      "name": "wood-outline",
      "color": "#3a2412"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        "...aa.......a...",
        "...bc.......c...",
        "...bc.......c...",
        "...bbdddddddc...",
        "...bdaaaaaacd...",
        "...bdabbbbbcd...",
        "...bdabbbbbcd...",
        "...bdcccccccd...",
        "...bbdddddddc...",
        "...bbcccccccc...",
        "...bc.......c...",
        "...bc.......c...",
        "...cc.......c...",
        "................",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
