{
  "$schema": "../../../schemas/sprite.schema.json",
  "schemaVersion": 1,
  "id": "earth-crystal",
  "name": "Earth Crystal",
  "kind": "object",
  "status": "outline",
  "description": "A cloudy mineral from the mines.",
  "tags": ["gem", "mineral"],
  "canvas": {
    "width": 16,
    "height": 16
  },
  "pivot": {
    "x": 8,
    "y": 16
  },
  "palette": {
    ".": {
      "name": "empty",
      "color": null
    },
    "a": {
      "name": "amethyst-light",
      "color": "#c093ef"
    },
    "b": {
      "name": "amethyst-base",
      "color": "#9155d6"
    },
    "c": {
      "name": "amethyst-dark",
      "color": "#6330a0"
    },
    "d": {
      "name": "amethyst-outline",
      "color": "#3a1a5c"
    }
  },
  "frames": {
    "idle-down": {
      "pixels": [
        "................",
        ".......aaa......",
        ".......bbc......",
        "......addba.....",
        ".....adacdba....",
        "....adabbcdba...",
        "...adccccccdba..",
        ".aadcddddddbdba.",
        ".bbdcdbbbbbdcdc.",
        ".ccbdbdddddcdc..",
        "...cbdcaaacdc...",
        "....cbdcbcdc....",
        ".....cbdcdc.....",
        "......cbdc......",
        ".......cc.......",
        "................"
      ]
    }
  },
  "animations": [
    {
      "id": "idle",
      "frameMs": 400,
      "directions": {
        "down": ["idle-down"]
      }
    }
  ]
}
